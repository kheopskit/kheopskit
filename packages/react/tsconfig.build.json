{
	"extends": "./tsconfig.json",
	"include": ["src"],
	"compilerOptions": {
		"composite": false,
		"declaration": true,
		"noEmit": false,
		// When building for publish, @kheopskit/core is an external dependency, so
		// resolve it to the built package instead of mapping it back to core's
		// sources. Dropping this override emits nicer declarations (core's types
		// referenced rather than inlined), but the emit then writes a .d.ts next to
		// every file of core/src — 51 of them — and `declarationDir` can't redirect
		// that, since rolldown-plugin-dts requires siblings.
		//
		// The cost of resolving to dist is that this build depends on core/dist
		// being present and complete. Build order (`pnpm build:packages`) provides
		// that, and `pnpm check:dts` verifies the result — see scripts/check-dts.mjs.
		"paths": {}
	}
}
