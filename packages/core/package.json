{
	"name": "@kheopskit/core",
	"version": "6.0.0-rc.6",
	"description": "Framework-agnostic wallet and account discovery for Polkadot, Ethereum and Solana dapps. Upgrading from v5? Read MIGRATING_TO_V6.md, shipped in this package.",
	"private": false,
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"MIGRATING_TO_V4.md",
		"MIGRATING_TO_V6.md",
		"CHANGELOG.md"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./polkadot": {
			"import": {
				"types": "./dist/polkadot.d.mts",
				"default": "./dist/polkadot.mjs"
			},
			"require": {
				"types": "./dist/polkadot.d.ts",
				"default": "./dist/polkadot.js"
			}
		},
		"./ethereum": {
			"import": {
				"types": "./dist/ethereum.d.mts",
				"default": "./dist/ethereum.mjs"
			},
			"require": {
				"types": "./dist/ethereum.d.ts",
				"default": "./dist/ethereum.js"
			}
		},
		"./solana": {
			"import": {
				"types": "./dist/solana.d.mts",
				"default": "./dist/solana.mjs"
			},
			"require": {
				"types": "./dist/solana.d.ts",
				"default": "./dist/solana.js"
			}
		},
		"./walletconnect": {
			"import": {
				"types": "./dist/walletconnect.d.mts",
				"default": "./dist/walletconnect.mjs"
			},
			"require": {
				"types": "./dist/walletconnect.d.ts",
				"default": "./dist/walletconnect.js"
			}
		},
		"./internal": {
			"import": {
				"types": "./dist/internal.d.mts",
				"default": "./dist/internal.mjs"
			},
			"require": {
				"types": "./dist/internal.d.ts",
				"default": "./dist/internal.js"
			}
		},
		"./testing": {
			"import": {
				"types": "./dist/testing.d.mts",
				"default": "./dist/testing.mjs"
			},
			"require": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			}
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run --root=../.. packages/core",
		"dev": "tsdown --watch",
		"build": "tsdown",
		"clean": "rm -rf ./dist && rm -rf ./node_modules",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [],
	"author": "Kheops (https://github.com/0xKheops)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kheopskit/kheopskit.git"
	},
	"license": "ISC",
	"peerDependencies": {
		"@reown/appkit": ">=1.7.0",
		"@solana/kit": ">=6.0.0",
		"@wallet-standard/app": ">=1.1.0",
		"@wallet-standard/base": ">=1.1.0",
		"mipd": ">=0.0.7",
		"polkadot-api": ">=2.0.0",
		"rxjs": ">=7.8.0",
		"viem": ">=2.0.0"
	},
	"peerDependenciesMeta": {
		"@reown/appkit": {
			"optional": true
		},
		"@solana/kit": {
			"optional": true
		},
		"@wallet-standard/app": {
			"optional": true
		},
		"@wallet-standard/base": {
			"optional": true
		},
		"mipd": {
			"optional": true
		},
		"polkadot-api": {
			"optional": true
		},
		"viem": {
			"optional": true
		}
	},
	"dependencies": {
		"@noble/hashes": "^2.4.0",
		"@scure/base": "^2.4.0",
		"lodash-es": "^4.18.1"
	},
	"devDependencies": {
		"@reown/appkit": "^1.8.24",
		"@solana/kit": "^8.4.0",
		"@solana/wallet-standard-features": "^1.5.0",
		"@types/lodash-es": "^4.17.12",
		"@wallet-standard/app": "^1.1.1",
		"@wallet-standard/base": "^1.1.1",
		"@wallet-standard/features": "^1.1.1",
		"mipd": "^0.0.7",
		"polkadot-api": "^3.3.0",
		"rxjs": "^7.8.2",
		"viem": "^2.57.3"
	},
	"tsdown": {
		"entry": [
			"src/index.ts",
			"src/polkadot.ts",
			"src/ethereum.ts",
			"src/solana.ts",
			"src/walletconnect.ts",
			"src/internal.ts",
			"src/testing.ts"
		],
		"tsconfig": "tsconfig.build.json",
		"fixedExtension": false,
		"sourcemap": true,
		"clean": true,
		"dts": true,
		"format": [
			"esm",
			"cjs"
		],
		"target": "es2020"
	}
}
